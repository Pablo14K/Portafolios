<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Muchos servidores IPTV y equipos de red local (Jellyfin, DLNA) solo hablan
      HTTP plano. Sin esto, Android 9+ los bloquea en silencio.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
