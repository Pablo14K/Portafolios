# ================================
# CONFIGURACIÓN PARA DESARROLLO
# ================================
# Copia este archivo como ".env" (sin el .example)
# y reemplaza los valores según tu entorno

# BASE DE DATOS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=facturacion_sifen
DB_USER=root
DB_PASS=

# SERVIDOR PHP
# Si php esta en el PATH del sistema, dejar PHP_EXECUTABLE vacio.
# Si no, indicar la ruta completa al binario, por ejemplo:
#   Windows standalone: C:\php\php.exe
#   Windows XAMPP:      C:\xampp\php\php.exe
#   Linux/macOS:        /usr/bin/php   o   /opt/homebrew/bin/php
PHP_HOST=127.0.0.1
PHP_PORT=8000
PHP_EXECUTABLE=

# SIFEN — modo de operación (sistema 100% PHP, sin Node.js)
#   mock = genera/firma/aprueba localmente, sin valor fiscal
#   test = homologación (requiere certificado)   |   prod = producción
SIFEN_MODE=mock

# === SIFEN — Certificado y CSC ===
# Certificado PFX/P12 emitido por un PSC habilitado por el MIC (modo test/prod):
SIFEN_CERT_P12_PATH=
SIFEN_CERT_P12_PASSWORD=
# Alternativa con PEM separado:
SIFEN_CERT_PEM_PATH=
SIFEN_PRIVATE_KEY_PEM_PATH=
SIFEN_PRIVATE_KEY_PASSWORD=
# CSC otorgado por la DNIT (id_csc: 4 dígitos, csc: 32 chars alfanuméricos)
SIFEN_ID_CSC=
SIFEN_CSC=

# CORREO (Opcional - para pruebas)
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Facturación Electrónica

# === PRUEBA DE SCRIPT → AUTOMATIZADOR SIFEN ===
# URL del endpoint HTTP del automatizador (carpeta public/ del sifen_automatizador).
# Ej: https://automatizador.tudominio.com/   (o  https://tudominio.com/automatizador/public/index.php)
AUTOMATIZADOR_URL=
# Token de la API del automatizador (= SIFEN_API_TOKEN del .env del automatizador).
AUTOMATIZADOR_TOKEN=

# ALMACENAMIENTO (rutas relativas desde la raíz del proyecto)
STORAGE_XML_DIR=./storage/xml
STORAGE_KUDE_DIR=./storage/kude
STORAGE_EMAIL_DIR=./storage/emails
STORAGE_LOG_DIR=./storage/logs
STORAGE_CERT_DIR=./storage/certs
