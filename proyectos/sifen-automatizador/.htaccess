# ============================================================
# .htaccess de la RAÍZ del automatizador (despliegue por SUBCARPETA)
# Solo la carpeta public/ debe verse desde la web. Esto bloquea el resto
# (.env con token/clave, motor/, src/, certs/, salida/, entrada/, etc.).
# ============================================================

Options -Indexes

# Negar el .env de forma explícita (defensa principal).
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bloquear acceso directo a archivos/carpetas sensibles de la raíz.
  RewriteRule (^|/)\.env  - [F]
  RewriteRule (^|/)\.git  - [F]
  RewriteRule ^(src|motor|bin|config|certs|entrada|procesados|errores|salida|logs)(/|$) - [F]
</IfModule>
